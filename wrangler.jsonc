/**
 * Cloudflare Worker config for the annot PWA (annot.work/app/*).
 *
 * The Worker script (`./worker.js`) does a small URL rewrite —
 * strip the `/app` prefix before consulting the static-asset
 * binding so the PWA's flat `dist/` layout serves correctly AND
 * the SPA fallback (`<assets-root>/index.html`) catches deep
 * links like `annot.work/app/edit/img/browser/foo`. See
 * `worker.js`'s docblock for the full reasoning.
 *
 * URL layout (Phase 8d of docs/plans/launch-prep.md, atomic
 * switchover):
 *
 *   annot.work/      → annot-marketing (landing site,
 *                       packages/marketing/wrangler.jsonc)
 *   annot.work/app   → THIS worker (PWA — 301 to /app/)
 *   annot.work/app/* → THIS worker (PWA, packages/web/dist/)
 *   annot.work/docs/*→ annot-docs-site
 *                       (packages/docs-site/wrangler.jsonc)
 *   annot.work/api/* → annot-api (packages/worker/wrangler.jsonc)
 *
 * Cloudflare resolves overlapping routes by longest-prefix match,
 * so the four route patterns coexist cleanly. The PWA was
 * previously bound to `annot.work/*`; that old binding must be
 * removed manually via the Cloudflare dashboard during the
 * cutover (see launch-prep.md's operator checklist).
 */
{
	"name": "annot",
	"compatibility_date": "2026-04-23",
	"main": "./worker.js",
	"workers_dev": false,
	"routes": [
		{
			"pattern": "annot.work/app",
			"zone_name": "annot.work"
		},
		{
			"pattern": "annot.work/app/*",
			"zone_name": "annot.work"
		}
	],
	"assets": {
		"directory": "./packages/web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	// Staging: `wrangler deploy --env staging` → annot-staging on
	// staging.annot.work/app*. Same worker.js + assets as prod; only
	// name + routes differ. See docs/plans/staging-environment.md.
	//
	// The unused top-level SESSIONS / D1 bindings were dropped here:
	// worker.js only reads `env.ASSETS` (URL rewrite), never the
	// session store or DB, so binding them widened the attack
	// surface for no reason (staging plan note).
	"env": {
		"staging": {
			"name": "annot-staging",
			"routes": [
				{
					"pattern": "staging.annot.work/app",
					"zone_name": "annot.work"
				},
				{
					"pattern": "staging.annot.work/app/*",
					"zone_name": "annot.work"
				}
			],
			"assets": {
				"directory": "./packages/web/dist",
				"binding": "ASSETS",
				"not_found_handling": "single-page-application"
			}
		}
	}
}
