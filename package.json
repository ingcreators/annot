{
  "name": "ingcreators",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingcreators/annot.git"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "lint": "biome lint packages",
    "lint:fix": "biome check packages --write",
    "format": "biome format packages --write",
    "check": "biome check packages",
    "audit": "pnpm audit --audit-level=high",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "fake-indexeddb": "^6",
    "happy-dom": "^20",
    "msw": "^2.6",
    "turbo": "^2.5.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "serialize-javascript@<7.0.3": ">=7.0.3"
    }
  }
}
