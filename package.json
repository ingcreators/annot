{
  "name": "annot",
  "version": "0.0.0",
  "private": true,
  "description": "SVG-first screenshot annotation toolkit — PWA, Chrome extension, and Tauri desktop sharing a single editor core.",
  "license": "Apache-2.0",
  "author": "ingcreators",
  "homepage": "https://github.com/ingcreators/annot#readme",
  "bugs": {
    "url": "https://github.com/ingcreators/annot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingcreators/annot.git"
  },
  "keywords": [
    "annotation",
    "screenshot",
    "svg",
    "pwa",
    "chrome-extension",
    "tauri",
    "lit",
    "monorepo"
  ],
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "lint": "biome lint packages",
    "lint:fix": "biome check packages --write",
    "format": "biome format packages --write",
    "check": "biome check packages",
    "audit": "pnpm audit --audit-level=high",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@material-symbols/svg-400": "^0.44.4",
    "fake-indexeddb": "^6",
    "happy-dom": "^20",
    "msw": "^2.13",
    "turbo": "^2.5.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "serialize-javascript@<7.0.3": ">=7.0.3"
    }
  }
}
