node_modules/
dist/
dist-electron/
storybook-static/
coverage/
.turbo/
*.tsbuildinfo

# Rust
target/
Cargo.lock
# Reproducible builds for in-tree native crates need a committed
# lockfile (cargo --locked). The leaf-crate scope means these
# exceptions are safe.
!packages/imagequant/Cargo.lock
!packages/desktop/native/win-clipboard/Cargo.lock

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Environment
.env
.env.local
.env.*.local
.env.production
.env.development

# Secrets — defensive deny-by-pattern so an accidental drop never
# even gets staged. Adding to this list is cheap; the CI `secret-scan`
# job (gitleaks) is the second layer that catches anything that slips
# past `git add`.
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
serviceAccountKey*.json
google-credentials*.json
secrets/
.secrets/

# Cloudflare Workers (wrangler)
# Miniflare local D1/KV/R2 state + tmp build artefacts — regenerated
# on every `wrangler dev` / `wrangler d1 ...` invocation.
.wrangler/
# Local-only Worker secrets for `wrangler dev`. Production secrets
# land via `wrangler secret put` and never touch the repo.
.dev.vars

# Claude Code (local-only)
.claude/settings.local.json
.claude/worktrees/
