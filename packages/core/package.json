{
  "name": "@ingcreators/annot-core",
  "version": "0.2.1",
  "description": "Annot SDK — SVG-first screenshot annotation format, storage abstractions, and editor primitives. The foundation shared by the PWA, Chrome extension, Electron desktop, VSCode extension, and the headless annotator.",
  "license": "Apache-2.0",
  "author": "ingcreators",
  "homepage": "https://github.com/ingcreators/annot/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/ingcreators/annot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingcreators/annot.git",
    "directory": "packages/core"
  },
  "keywords": [
    "annotation",
    "screenshot",
    "svg",
    "editor",
    "storage",
    "headless",
    "annot"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./headless": "./src/headless.ts",
    "./editor": "./src/editor/index.ts",
    "./editor/*": "./src/editor/*.ts",
    "./icons": "./src/icons/index.ts",
    "./icons/*": "./src/icons/*.ts",
    "./xmp": "./src/xmp/xmp-browser.ts",
    "./xmp-bytes": "./src/xmp/xmp-bytes.ts",
    "./zip": "./src/zip/zip-builder.ts",
    "./zip-bytes": "./src/zip/zip-bytes.ts",
    "./utils": "./src/utils/index.ts",
    "./utils/*": "./src/utils/*.ts",
    "./desktop-bridge": "./src/utils/desktop-bridge.ts",
    "./storage": "./src/storage/index.ts",
    "./encode": "./src/encode/index.ts",
    "./encode/options": "./src/encode/options.ts",
    "./encode/png8": "./src/encode/png8.ts",
    "./encode/quantize-median-cut": "./src/encode/quantize-median-cut.ts",
    "./auto-capture-options": "./src/auto-capture-options.ts",
    "./styles/*": "./styles/*"
  },
  "files": [
    "dist",
    "styles",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./xmp-bytes": {
        "types": "./dist/xmp/xmp-bytes.d.ts",
        "default": "./dist/xmp-bytes.js"
      },
      "./styles/*": "./styles/*"
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "bench:quantize": "node --experimental-strip-types --no-warnings scripts/bench-quantize.ts"
  },
  "devDependencies": {
    "@types/pako": "^2.0.4",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "^5.0.1"
  },
  "dependencies": {
    "pako": "^2.1.0"
  }
}
