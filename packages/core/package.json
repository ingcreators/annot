{
  "name": "@ingcreators/annot-core",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingcreators/annot.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./headless": "./src/headless.ts",
    "./editor": "./src/editor/index.ts",
    "./editor/*": "./src/editor/*.ts",
    "./icons": "./src/icons/index.ts",
    "./icons/*": "./src/icons/*.ts",
    "./xmp": "./src/xmp/xmp-browser.ts",
    "./zip": "./src/zip/zip-builder.ts",
    "./zip-bytes": "./src/zip/zip-bytes.ts",
    "./utils": "./src/utils/index.ts",
    "./utils/*": "./src/utils/*.ts",
    "./tauri-bridge": "./src/utils/tauri-bridge.ts",
    "./desktop-bridge": "./src/utils/desktop-bridge.ts",
    "./storage": "./src/storage/index.ts",
    "./encode": "./src/encode/index.ts",
    "./styles/*": "./styles/*"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/pako": "^2.0.4",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "^5.0.0"
  },
  "dependencies": {
    "@ingcreators/annot-imagequant": "workspace:*",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "pako": "^2.1.0"
  }
}
