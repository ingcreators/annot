/**
 * Wrangler config for `@ingcreators/annot-worker`.
 *
 * Hosts Annot's API surface (GitHub OAuth + GitHub App + future
 * AnnotCloudStore endpoints + share / embed). Distinct from the
 * repo-root `wrangler.jsonc` which deploys the static PWA at
 * `annot.work`.
 *
 * **Why JSONC and not TOML**: wrangler walks up the directory
 * tree looking for config files, AND it checks `.jsonc` first at
 * each level. The repo root has a `wrangler.jsonc` for the PWA.
 * If this package had `wrangler.toml`, wrangler would walk up
 * past it (because TOML is checked last) and pick up the root's
 * PWA config by mistake — leading to "No migrations present at
 * <root>/migrations" errors. Having this package use `.jsonc`
 * too means wrangler stops at the closer match.
 *
 * Phase 2c: KV / D1 bindings wired. Secrets (GITHUB_OAUTH_*)
 * land via `wrangler secret put`. Phase 2c follow-up adds the
 * `api.annot.work` route binding.
 */
{
  "name": "annot-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],

  // Enable the *.workers.dev subdomain so the Worker has a public
  // URL for OAuth callback testing. Production routing to
  // `api.annot.work` lands in Phase 2c follow-up.
  "workers_dev": true,

  // Observability: enable Workers Logs (zero cost on the free
  // tier for low-volume traffic). Helpful when debugging OAuth
  // flows against real GitHub callbacks.
  "observability": {
    "enabled": true
  },

  // ─── Bindings ────────────────────────────────────────────
  //
  // Resource IDs below are Cloudflare-internal identifiers (NOT
  // credentials). They identify which KV namespace / D1 database
  // the Worker reads — access still requires the Cloudflare API
  // token. Same publish-as-plaintext stance as wrangler.jsonc
  // files in every Cloudflare Workers OSS project.

  // KV namespace for session cookies + OAuth CSRF state.
  // Created via:
  //   wrangler kv namespace create SESSIONS
  //   wrangler kv namespace create SESSIONS --preview
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "bcf47845acab46ba92254f167bab5190",
      "preview_id": "6927e8127e8147c498fdd265f2f81fcb"
    }
  ],

  // D1 database for the multi-tenant schema (users / workspaces /
  // images / documents / share_links / audit_events). Phase 3
  // lands the tables; Phase 2b wired the binding.
  // Created via:
  //   wrangler d1 create annot-db
  //   wrangler d1 migrations apply annot-db   # once migrations exist
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "annot-db",
      "database_id": "30492e01-73f8-4898-8e04-96af6f805acb",
      "migrations_dir": "migrations"
    }
  ]

  // Future bindings to add as their phases land:
  //   - Phase 4: r2_buckets binding = "OBJECTS" for image bytes
  //
  // Secrets (set via `wrangler secret put`):
  //   - GITHUB_OAUTH_CLIENT_ID    (Phase 2c)
  //   - GITHUB_OAUTH_CLIENT_SECRET (Phase 2c)
  //   - GITHUB_APP_PRIVATE_KEY    (Phase 2c follow-up)
  //   - GITHUB_WEBHOOK_SECRET     (Phase 2c follow-up)
  //   - GOOGLE_OAUTH_CLIENT_ID    (Phase 3)
  //   - GOOGLE_OAUTH_CLIENT_SECRET (Phase 3)
  //   - STRIPE_SECRET_KEY         (Phase 7)
  //   - STRIPE_WEBHOOK_SECRET     (Phase 7)
}
