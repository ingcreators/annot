/**
 * Wrangler config for `@ingcreators/annot-worker`.
 *
 * Hosts Annot's API surface (GitHub OAuth + GitHub App + future
 * AnnotCloudStore endpoints + share / embed). Distinct from the
 * repo-root `wrangler.jsonc` which deploys the static PWA at
 * `annot.work`.
 *
 * **Why JSONC and not TOML**: wrangler walks up the directory
 * tree looking for config files, AND it checks `.jsonc` first at
 * each level. The repo root has a `wrangler.jsonc` for the PWA.
 * If this package had `wrangler.toml`, wrangler would walk up
 * past it (because TOML is checked last) and pick up the root's
 * PWA config by mistake — leading to "No migrations present at
 * <root>/migrations" errors. Having this package use `.jsonc`
 * too means wrangler stops at the closer match.
 *
 * Phase 4a: R2 bucket binding added alongside the Phase 2b
 * KV / D1 bindings. Phase 4b/4c/4d add migrations + endpoints
 * that read/write the bucket.
 *
 * Same-origin routing (this PR): `annot.work/api/*` is bound to
 * this Worker so the PWA at `annot.work` can call the API
 * without crossing origins. Same-origin means session cookies
 * just work (no third-party-cookie issue in Safari ITP /
 * Chrome's 3P-cookie phase-out) and no CORS configuration.
 * The PWA's `AnnotCloudStore` defaults to a `""` base URL,
 * which becomes `<pwa-origin>/api/...` at request time and
 * lands on this Worker via the route binding.
 */
{
  "name": "annot-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],

  // Workers.dev subdomain stays enabled alongside the production
  // route binding so:
  //   - Local Wrangler test deploys have a public URL even
  //     before the zone routing propagates.
  //   - Self-hosters who don't own `annot.work` can deploy this
  //     Worker to their own account + reach it via
  //     `annot-api.<account>.workers.dev` (their PWA's
  //     "Advanced" cloud-connect override then points at the
  //     `*.workers.dev` URL).
  "workers_dev": true,

  // Production route binding: `annot.work/api/*` resolves to
  // this Worker. The root `wrangler.jsonc` (PWA static assets)
  // claims everything else under `annot.work` — Cloudflare
  // routes a request to whichever Worker has the most-specific
  // matching pattern, so `annot.work/api/foo` lands here while
  // `annot.work/` still lands on the PWA assets Worker.
  //
  // Requires the `annot.work` zone to exist on the deploying
  // Cloudflare account AND the deploy token to have `Zone:Edit`
  // (or just `Zone:Read` + `Worker Routes:Edit`) for it. Adding
  // a route to a zone the token can't manage fails the deploy
  // with a 403 — re-issue the API token via the dashboard with
  // the missing scope.
  "routes": [
    {
      "pattern": "annot.work/api/*",
      "zone_name": "annot.work"
    }
  ],

  // Observability: enable Workers Logs (zero cost on the free
  // tier for low-volume traffic). Helpful when debugging OAuth
  // flows against real GitHub callbacks.
  "observability": {
    "enabled": true
  },

  // ─── Bindings ────────────────────────────────────────────
  //
  // Resource IDs below are Cloudflare-internal identifiers (NOT
  // credentials). They identify which KV namespace / D1 database
  // the Worker reads — access still requires the Cloudflare API
  // token. Same publish-as-plaintext stance as wrangler.jsonc
  // files in every Cloudflare Workers OSS project.

  // KV namespace for session cookies + OAuth CSRF state.
  // Created via:
  //   wrangler kv namespace create SESSIONS
  //   wrangler kv namespace create SESSIONS --preview
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "bcf47845acab46ba92254f167bab5190",
      "preview_id": "6927e8127e8147c498fdd265f2f81fcb"
    }
  ],

  // D1 database for the multi-tenant schema (users / workspaces /
  // images / documents / share_links / audit_events). Phase 3
  // lands the tables; Phase 2b wired the binding.
  // Created via:
  //   wrangler d1 create annot-db
  //   wrangler d1 migrations apply annot-db   # once migrations exist
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "annot-db",
      "database_id": "30492e01-73f8-4898-8e04-96af6f805acb",
      "migrations_dir": "migrations"
    }
  ],

  // R2 bucket holding the actual bytes of every image and
  // document (annotation SVGs, original screenshots, exported
  // PNGs, .annot.html docs). Phase 4 lands the
  // /api/images/* and /api/documents/* endpoints that write to
  // this bucket; Phase 4a (this PR) just wires the binding.
  //
  // R2 charges $0.015 / GB-month storage and ZERO egress —
  // perfect fit for hosting user-uploaded images that get viewed
  // many times after upload. (S3 / GCS egress would dominate
  // the cost; R2 lets us keep the free tier viable.)
  //
  // Created via:
  //   wrangler r2 bucket create annot-objects
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "annot-objects"
    }
  ]

  // Secrets (set via `wrangler secret put`):
  //   - GITHUB_OAUTH_CLIENT_ID    (Phase 2c)
  //   - GITHUB_OAUTH_CLIENT_SECRET (Phase 2c)
  //   - GITHUB_APP_PRIVATE_KEY    (Phase 2c follow-up)
  //   - GITHUB_WEBHOOK_SECRET     (Phase 2c follow-up)
  //   - GOOGLE_OAUTH_CLIENT_ID    (Phase 3c)
  //   - GOOGLE_OAUTH_CLIENT_SECRET (Phase 3c)
  //   - STRIPE_SECRET_KEY         (Phase 7)
  //   - STRIPE_WEBHOOK_SECRET     (Phase 7)
}
