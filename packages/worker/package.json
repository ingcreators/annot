{
  "name": "@ingcreators/annot-worker",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare Worker hosting Annot's API surface (GitHub OAuth, GitHub App, AnnotCloudStore endpoints, share / embed). Phase 2a of the Excalidraw-route cloud roadmap (`docs/plans/annot-cloud-roadmap.md`).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingcreators/annot.git",
    "directory": "packages/worker"
  },
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "migrations:list": "wrangler d1 migrations list annot-db",
    "migrations:apply:local": "wrangler d1 migrations apply annot-db --local",
    "migrations:apply": "wrangler d1 migrations apply annot-db --remote",
    "d1:exec": "wrangler d1 execute annot-db",
    "secrets:list": "wrangler secret list",
    "secrets:put:github-client-id": "wrangler secret put GITHUB_OAUTH_CLIENT_ID",
    "secrets:put:github-client-secret": "wrangler secret put GITHUB_OAUTH_CLIENT_SECRET",
    "secrets:put:google-client-id": "wrangler secret put GOOGLE_OAUTH_CLIENT_ID",
    "secrets:put:google-client-secret": "wrangler secret put GOOGLE_OAUTH_CLIENT_SECRET",
    "secrets:put:github-app-id": "wrangler secret put GITHUB_APP_ID",
    "secrets:put:github-app-client-id": "wrangler secret put GITHUB_APP_CLIENT_ID",
    "secrets:put:github-app-client-secret": "wrangler secret put GITHUB_APP_CLIENT_SECRET",
    "secrets:put:github-app-private-key": "wrangler secret put GITHUB_APP_PRIVATE_KEY",
    "secrets:put:github-app-webhook-secret": "wrangler secret put GITHUB_APP_WEBHOOK_SECRET",
    "setup-customer": "tsx scripts/setup-customer.ts",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@ingcreators/annot-embed-protocol": "workspace:*",
    "hono": "^4.12.22"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260524.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "better-sqlite3": "^12.4.1",
    "typescript": "catalog:",
    "wrangler": "^4.94.0"
  }
}
