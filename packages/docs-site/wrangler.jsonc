/**
 * Cloudflare Workers Static Assets config for the Astro Starlight
 * documentation site at `packages/docs-site/`.
 *
 * Claims `annot.work/docs/*` directly. The legacy VitePress
 * sibling (the Phase 6 picker Worker) was retired in the
 * "retire VitePress + English-only" follow-up to
 * `docs/plans/_done/annot-work-astro-unification.md` — the
 * one-release-cycle grace was skipped because nobody had
 * started reading the docs yet.
 *
 * URL layout:
 *
 *   annot.work/      → annot-marketing (landing)
 *   annot.work/app/* → annot (PWA at /app/)
 *   annot.work/docs/*→ THIS worker (Astro Starlight)
 *   annot.work/api/* → annot-api
 *
 * Astro is configured with `base: "/docs/"` so every internal
 * link in the built HTML already includes that prefix.
 * `not_found_handling: "404-page"` because Astro emits a
 * per-route static file — falling through to an index page
 * would be wrong.
 *
 * The Cloudflare-side Worker name stays `annot-docs-site-astro`
 * (rather than the conventional `annot-docs-site`) until the
 * legacy `annot-docs-site` Worker is deleted from the Cloudflare
 * dashboard, which would free the name. That step is operator-
 * driven; until it happens, `routes: annot.work/docs/*` lives
 * on this Worker by route-pattern claim alone, and the legacy
 * Worker can be deleted from Cloudflare at the operator's
 * convenience without affecting traffic.
 */
{
  "name": "annot-docs-site-astro",
  "compatibility_date": "2026-04-23",
  "main": "./worker.js",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "annot.work/docs",
      "zone_name": "annot.work"
    },
    {
      "pattern": "annot.work/docs/*",
      "zone_name": "annot.work"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // Staging: `wrangler deploy --env staging` → annot-docs-site-astro-staging
  // on staging.annot.work/docs*. Same worker.js + assets as prod;
  // only name + routes differ. See docs/plans/staging-environment.md.
  "env": {
    "staging": {
      "name": "annot-docs-site-astro-staging",
      "routes": [
        {
          "pattern": "staging.annot.work/docs",
          "zone_name": "annot.work"
        },
        {
          "pattern": "staging.annot.work/docs/*",
          "zone_name": "annot.work"
        }
      ],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page"
      }
    }
  }
}
