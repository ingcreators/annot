/**
 * Cloudflare Workers Static Assets config for the annot.work/docs
 * VitePress documentation site.
 *
 * No Worker script — just the VitePress static build from
 * `.vitepress/dist/docs/` behind Cloudflare's asset server.
 *
 * VitePress is configured to write to `.vitepress/dist/docs/`
 * (not the default `dist/`) so the on-disk layout mirrors the
 * public URL space — Cloudflare's static-asset binding includes
 * the route prefix when mapping URL → file, so a request to
 * `annot.work/docs/getting-started/` lands on
 * `<assets.directory>/docs/getting-started/index.html`.
 *
 * URL layout (Phase 8d of docs/plans/launch-prep.md):
 *
 *   annot.work/      → annot-marketing (landing site)
 *   annot.work/app/* → annot (PWA)
 *   annot.work/docs/*→ THIS worker (VitePress docs)
 *   annot.work/api/* → annot-api
 *
 * Cloudflare resolves overlapping routes by longest-prefix match
 * — `annot.work/docs/*` is more specific than the marketing
 * worker's `annot.work/*`, so it wins.
 *
 * VitePress is configured with `base: "/docs/"` so every
 * internal link in the built HTML already includes that prefix.
 * `not_found_handling: "404-page"` because VitePress emits a
 * per-route static file — falling through to an index page
 * would be wrong.
 */
{
  "name": "annot-docs-site",
  "compatibility_date": "2026-04-23",
  "main": "./worker.js",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "annot.work/docs",
      "zone_name": "annot.work"
    },
    {
      "pattern": "annot.work/docs/*",
      "zone_name": "annot.work"
    }
  ],
  "assets": {
    "directory": "./.vitepress/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // Phase 6 of `docs/plans/annot-work-astro-unification.md` —
  // feature-flag cutover. The new Astro Starlight worker
  // (`annot-docs-site-astro`) runs in parallel; this binding
  // lets the per-request stack picker in `worker.js` proxy
  // requests over when the cookie / query param opts in.
  // The binding is removed in Phase 6.5 (the 7-day-observation
  // TODO in the plan), at which point the Astro worker claims
  // the `annot.work/docs/*` route directly and this one is
  // retired alongside the VitePress source.
  "services": [
    {
      "binding": "ASTRO",
      "service": "annot-docs-site-astro"
    }
  ]
}
