{
  "$schema": "https://raw.githubusercontent.com/nickelpack/schema-store/refs/heads/main/schemas/tauri/tauri.conf.json-v2.json",
  "productName": "SVGShot",
  "version": "1.0.0",
  "identifier": "com.ingcreators.annot",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SVGShot",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": ["resources/tool-presets.yml"]
  }
}
