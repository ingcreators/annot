{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // `chrome-types` covers the `chrome.runtime` symbols
    // `@ingcreators/annot-web/storage/bridge` references — needed
    // because Phase 2 of `desktop-storage-provider-migration.md`
    // imports the unified gallery's `FileManager` from the web
    // package, which transitively pulls those types in. Vite
    // strips the actual chrome.* call sites at build time (the
    // desktop never reaches that code path); the types are
    // typecheck-only.
    //
    // `node` is here because Phase 1 of
    // `desktop-electron-migration.md` adds renderer-side tests
    // (`desktop-fs.electron.test.ts`) that exercise the
    // Node-side `fs.*` IPC handlers against a tmpdir. Production
    // renderer code doesn't import from `node:*`; the types are
    // a typecheck-only seam for the test files that round-trip
    // through `src-electron/ipc/fs.ts`.
    "types": ["chrome-types", "node"]
  },
  "include": ["src/**/*.ts"]
}
