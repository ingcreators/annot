{
  "name": "@ingcreators/annot-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingcreators/annot.git",
    "directory": "packages/desktop"
  },
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:frontend": "vite",
    "build:frontend": "vite build",
    "dev:electron": "electron-vite dev",
    "build:electron": "electron-vite build",
    "typecheck": "tsc --noEmit && tsc -p src-electron/tsconfig.json --noEmit",
    "tauri": "tauri"
  },
  "build": {
    "appId": "com.ingcreators.annot",
    "productName": "Annot",
    "files": [
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "build/tool-presets.yml",
        "to": "tool-presets.yml"
      }
    ]
  },
  "dependencies": {
    "@ingcreators/annot-core": "workspace:*",
    "@ingcreators/annot-editor": "workspace:*",
    "@ingcreators/annot-editor-shell": "workspace:*",
    "@ingcreators/annot-web": "workspace:*",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25",
    "chrome-types": "^0.1.327",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "6.0.0-beta.1",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
