{
  "name": "@ingcreators/annot-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingcreators/annot.git",
    "directory": "packages/desktop"
  },
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "e2e": "pnpm build && xvfb-run -a pnpm exec playwright test",
    "typecheck": "tsc --noEmit && tsc -p src-electron/tsconfig.json --noEmit && tsc --noEmit -p tests/e2e"
  },
  "build": {
    "appId": "com.ingcreators.annot",
    "productName": "Annot",
    "artifactName": "annot-${version}-${arch}.${ext}",
    "files": [
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "build/tool-presets.yml",
        "to": "tool-presets.yml"
      },
      {
        "from": "native/win-clipboard/prebuilds/win-clipboard.win32-x64.node",
        "to": "win-clipboard.node"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Annot captures screenshots of the screen and individual windows for annotation. Granting permission lets the in-app capture buttons (and the Chrome extension's send-to-local-desktop handoff) reach the pixels they need.",
        "NSCameraUsageDescription": "Annot does not use the camera; this entry exists only to satisfy macOS's hardened-runtime metadata expectations.",
        "NSMicrophoneUsageDescription": "Annot does not use the microphone; this entry exists only to satisfy macOS's hardened-runtime metadata expectations.",
        "LSMinimumSystemVersion": "11.0.0"
      }
    },
    "dmg": {
      "sign": false
    },
    "linux": {
      "category": "Graphics;Utility",
      "synopsis": "SVG-first screenshot annotation tool",
      "description": "Annot is a screenshot annotation tool that lets you mark up captures with arrows, text, blur, mosaic, and more. Annotations stay editable — they're saved alongside the original image as XMP metadata so you can revisit and tweak them later.",
      "maintainer": "ingcreators <support@ingcreators.com>",
      "executableName": "annot",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    },
    "appImage": {
      "license": "../../LICENSE"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid",
        "libsecret"
      ]
    }
  },
  "dependencies": {
    "@ingcreators/annot-capture": "workspace:*",
    "@ingcreators/annot-core": "workspace:*",
    "@ingcreators/annot-doc": "workspace:*",
    "@ingcreators/annot-editor": "workspace:*",
    "@ingcreators/annot-host-ui": "workspace:*",
    "@ingcreators/annot-web": "workspace:*",
    "js-yaml": "^4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26",
    "chrome-types": "^0.1.433",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
