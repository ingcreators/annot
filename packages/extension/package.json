{
  "name": "@ingcreators/annot-extension",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingcreators/annot.git",
    "directory": "packages/extension"
  },
  "type": "module",
  "scripts": {
    "build": "vite build && node -e \"require('fs').copyFileSync('manifests/chrome.json','dist/manifest.json')\"",
    "build:chrome": "vite build && node -e \"require('fs').copyFileSync('manifests/chrome.json','dist/manifest.json')\"",
    "build:edge": "vite build && node -e \"require('fs').copyFileSync('manifests/chrome.json','dist/manifest.json')\"",
    "package:chrome": "pnpm build:chrome && node scripts/zip-dist.mjs chrome",
    "package:edge": "pnpm build:edge && node scripts/zip-dist.mjs edge",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "icons": "node ../../brand/generate-app-icons.mjs"
  },
  "dependencies": {
    "@ingcreators/annot-core": "workspace:*"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "chrome-types": "^0.1.327",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  }
}
