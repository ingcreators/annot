{
  "name": "@ingcreators/annot-vscode",
  "version": "0.1.0",
  "private": true,
  "displayName": "Annot",
  "description": "Edit Annot screenshot annotation files (.annot.svg / .annot.png / .annot.jpeg / .annot.jpg) and multi-image documents (.annot.html) directly inside VSCode.",
  "publisher": "ingcreators",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingcreators/annot.git",
    "directory": "packages/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "type": "module",
  "main": "./dist/extension.cjs",
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "annot",
    "annotation",
    "screenshot",
    "svg",
    "playwright"
  ],
  "license": "Apache-2.0",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "annot.editor",
        "displayName": "Annot Editor",
        "selector": [
          {
            "filenamePattern": "*.annot.svg"
          },
          {
            "filenamePattern": "*.annot.png"
          },
          {
            "filenamePattern": "*.annot.jpeg"
          },
          {
            "filenamePattern": "*.annot.jpg"
          },
          {
            "filenamePattern": "*.annot.html"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "annot.openAnnotation",
        "title": "Open annotation",
        "category": "Annot"
      },
      {
        "command": "annot.newFromClipboard",
        "title": "New annotation from clipboard image",
        "category": "Annot"
      },
      {
        "command": "annot.newFromImage",
        "title": "New annotation from image…",
        "category": "Annot"
      },
      {
        "command": "annot.newDocument",
        "title": "New document",
        "category": "Annot"
      },
      {
        "command": "annot.saveAsPng",
        "title": "Save as PNG…",
        "category": "Annot"
      },
      {
        "command": "annot.saveAsJpeg",
        "title": "Save as JPEG…",
        "category": "Annot"
      },
      {
        "command": "annot.exportPptx",
        "title": "Export to PowerPoint…",
        "category": "Annot"
      },
      {
        "command": "annot.revealInExplorer",
        "title": "Reveal in Explorer",
        "category": "Annot"
      },
      {
        "command": "annot.showFileDetails",
        "title": "Show file details",
        "category": "Annot"
      }
    ]
  },
  "scripts": {
    "build:extension": "vite build --config vite.extension.config.ts",
    "build:webview": "vite build --config vite.webview.config.ts",
    "build": "pnpm run build:extension && pnpm run build:webview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/e2e",
    "e2e": "pnpm build && xvfb-run -a pnpm exec playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26",
    "@types/vscode": "^1.125.0",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "dependencies": {
    "@ingcreators/annot-core": "workspace:*",
    "@ingcreators/annot-doc": "workspace:*",
    "@ingcreators/annot-editor": "workspace:*",
    "@ingcreators/annot-host-ui": "workspace:*",
    "@ingcreators/annot-render": "workspace:*"
  }
}
