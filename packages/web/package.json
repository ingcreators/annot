{
  "name": "@ingcreators/annot-web",
  "version": "0.1.0",
  "private": true,
  "description": "Annot — web app (by ingcreators)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingcreators/annot.git",
    "directory": "packages/web"
  },
  "type": "module",
  "exports": {
    "./lit": "./src/lit.ts",
    "./editor/*": "./src/editor/*.ts",
    "./storage/*": "./src/storage/*.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/e2e",
    "e2e": "playwright test",
    "icons": "node ../../brand/generate-app-icons.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@ingcreators/annot-capture": "workspace:*",
    "@ingcreators/annot-cloud-store": "workspace:*",
    "@ingcreators/annot-core": "workspace:*",
    "@ingcreators/annot-doc": "workspace:*",
    "@ingcreators/annot-editor": "workspace:*",
    "@ingcreators/annot-host-ui": "workspace:*",
    "@ingcreators/annot-render": "workspace:*",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26",
    "@storybook/addon-a11y": "^10.5.2",
    "@storybook/web-components-vite": "^10.5.2",
    "chrome-types": "^0.1.435",
    "storybook": "^10.5.2",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
