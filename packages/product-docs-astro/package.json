{
  "name": "@ingcreators/annot-product-docs-astro",
  "version": "0.2.1",
  "description": "Astro integration for `@ingcreators/annot-product-docs`. Wires the MDX components (`<Screen>` / `<Overlay>` / `<Transition>` / `<HistoryEntry>` / `<ScreenList>` / `<TransitionGraph>`) into an Astro site and supplies the Image Service that renders annotated PNGs from `<Screen>` blocks at build time. Phase 2 of docs/plans/living-product-docs.md.",
  "license": "Apache-2.0",
  "author": "ingcreators",
  "homepage": "https://github.com/ingcreators/annot/tree/main/packages/product-docs-astro#readme",
  "bugs": {
    "url": "https://github.com/ingcreators/annot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingcreators/annot.git",
    "directory": "packages/product-docs-astro"
  },
  "keywords": [
    "annotation",
    "screenshot",
    "astro",
    "astro-integration",
    "mdx",
    "docs",
    "documentation",
    "screen-spec",
    "screen-specifications",
    "image-service"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./playwright": "./src/playwright/index.ts",
    "./components/Screen.astro": "./src/components/Screen.astro",
    "./components/Overlay.astro": "./src/components/Overlay.astro",
    "./components/Transition.astro": "./src/components/Transition.astro",
    "./components/TransitionTable.astro": "./src/components/TransitionTable.astro",
    "./components/HistoryEntry.astro": "./src/components/HistoryEntry.astro",
    "./components/ScreenList.astro": "./src/components/ScreenList.astro",
    "./components/TransitionGraph.astro": "./src/components/TransitionGraph.astro"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./playwright": {
        "types": "./dist/playwright/index.d.ts",
        "default": "./dist/playwright/index.js"
      },
      "./components/Screen.astro": "./dist/components/Screen.astro",
      "./components/Overlay.astro": "./dist/components/Overlay.astro",
      "./components/Transition.astro": "./dist/components/Transition.astro",
      "./components/TransitionTable.astro": "./dist/components/TransitionTable.astro",
      "./components/HistoryEntry.astro": "./dist/components/HistoryEntry.astro",
      "./components/ScreenList.astro": "./dist/components/ScreenList.astro",
      "./components/TransitionGraph.astro": "./dist/components/TransitionGraph.astro"
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "astro": "^6.3.6",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "^5.0.1"
  },
  "dependencies": {
    "@ingcreators/annot-annotator": "workspace:*",
    "@ingcreators/annot-core": "workspace:*",
    "@ingcreators/annot-product-docs": "workspace:*"
  },
  "peerDependencies": {
    "@playwright/test": "^1.42.0",
    "astro": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  }
}
