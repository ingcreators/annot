{
  "name": "@ingcreators/annot-product-docs",
  "version": "0.5.1",
  "description": "Living product docs core — parse `.mdx` files with `annot:` frontmatter, resolve `<Overlay match>` keys against live Playwright `aria-snapshot` trees, run drift detection against the rendered UI, and ship a Playwright `screen` fixture that re-captures + re-syncs MDX snapshot blocks. Tier A (Node-only). Phase 1 of docs/plans/living-product-docs.md.",
  "license": "Apache-2.0",
  "author": "ingcreators",
  "homepage": "https://github.com/ingcreators/annot/tree/main/packages/product-docs#readme",
  "bugs": {
    "url": "https://github.com/ingcreators/annot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingcreators/annot.git",
    "directory": "packages/product-docs"
  },
  "keywords": [
    "annotation",
    "screenshot",
    "playwright",
    "mdx",
    "docs",
    "documentation",
    "screen-spec",
    "screen-specifications",
    "drift",
    "aria-snapshot"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./annotations-yaml": "./src/annotations-yaml.ts"
  },
  "bin": {
    "annot-docs": "./bin/annot-docs.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./annotations-yaml": {
        "types": "./dist/annotations-yaml.d.ts",
        "default": "./dist/annotations-yaml.js"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "^5.1.0"
  },
  "dependencies": {
    "@ingcreators/annot-annotator": "workspace:*",
    "@ingcreators/annot-core": "workspace:*",
    "@ingcreators/annot-playwright": "workspace:*",
    "js-yaml": "^4.2.0",
    "playwright-core": "^1.61.1",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@playwright/test": "^1.40.0"
  }
}
