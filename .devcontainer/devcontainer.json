{
  "name": "annot-dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspace/annot",
  "remoteUser": "node",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "mounts": [
    "source=annot-claude-${devcontainerId},target=/home/node/.claude,type=volume",
    "source=annot-codex-${devcontainerId},target=/home/node/.codex,type=volume",
    "source=annot-gh-${devcontainerId},target=/home/node/.config/gh,type=volume",
    "source=annot-npm-${devcontainerId},target=/home/node/.npm,type=volume",
    "source=annot-pnpm-store-${devcontainerId},target=/home/node/.local/share/pnpm,type=volume",
    "source=annot-playwright-${devcontainerId},target=/home/node/.cache/ms-playwright,type=volume"
  ],
  "remoteEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "CODEX_HOME": "/home/node/.codex"
  },
  "forwardPorts": [3000, 4321, 4322, 6006, 8787],
  "portsAttributes": {
    "3000": { "label": "web (PWA, Vite dev server)" },
    "4321": { "label": "marketing (Astro)" },
    "4322": { "label": "docs-site (Astro Starlight)" },
    "6006": { "label": "Storybook" },
    "8787": { "label": "worker (wrangler dev)" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "biomejs.biome",
        "astro-build.astro-vscode",
        "runem.lit-plugin"
      ],
      "settings": {
        "files.eol": "\n"
      }
    }
  },
  "postCreateCommand": "bash scripts/devcontainer-post-create.sh",
  "postStartCommand": "bash scripts/devcontainer-post-start.sh"
}
