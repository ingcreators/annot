{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "annotating-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@ingcreators/annot-web", "dev"],
      "port": 3000
    },
    {
      "name": "annot-storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@ingcreators/annot-web", "exec", "storybook", "dev", "-p", "6006", "--no-open"],
      "port": 6006
    },
    {
      "name": "annot-extension-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@ingcreators/annot-extension", "exec", "vite", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "annot-docs-site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@ingcreators/annot-docs-site", "exec", "astro", "dev", "--port", "4321", "--host", "127.0.0.1"],
      "port": 4321
    },
    {
      "name": "annot-marketing",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@ingcreators/annot-marketing", "exec", "astro", "dev", "--port", "4322", "--host", "127.0.0.1"],
      "port": 4322
    },
    {
      "name": "workflow-app-example",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "examples/workflow-app", "run", "dev"],
      "port": 5173
    },
    {
      "name": "workflow-app-docs-site",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "examples/workflow-app/docs-site", "run", "dev", "--", "--port", "4321", "--host", "127.0.0.1"],
      "port": 4321
    }
  ]
}
