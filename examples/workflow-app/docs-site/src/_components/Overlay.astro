---
// Local vendored copy of `<Overlay>` while the upstream
// `@ingcreators/annot-product-docs-astro@0.1.0` publish is
// missing its `dist/` directory (fix #947). The published
// source lives at
// `packages/product-docs-astro/src/components/Overlay.astro`
// in the monorepo; this file is a byte-for-byte copy.

interface Match {
  role: string;
  name: string;
  under?: Match;
}
type Intent =
  | "info"
  | "warning"
  | "error"
  | "success"
  | "neutral"
  | "required"
  | "action";

interface Props {
  match: Match;
  intent?: Intent;
  number?: number;
}
const { match, intent, number } = Astro.props;
---
<li
  class="annot-overlay"
  data-intent={intent}
  data-overlay-number={number}
  data-match-role={match.role}
  data-match-name={match.name}
>
  {number !== undefined && (
    <span class="annot-overlay-number" aria-hidden="true">{number}</span>
  )}
  <div class="annot-overlay-body">
    <slot />
  </div>
</li>
