---
// Local vendored copy of `<Screen>` while the upstream
// `@ingcreators/annot-product-docs-astro@0.1.0` publish is
// missing its `dist/` directory (fix #947). The published
// source lives at
// `packages/product-docs-astro/src/components/Screen.astro`
// in the monorepo; this file is a byte-for-byte copy.

interface Props {
  id: string;
  src: string;
  alt?: string;
}
const { id, src, alt } = Astro.props;
---
<figure class="annot-screen" data-screen-id={id}>
  <img src={src} alt={alt ?? `Screen ${id}`} loading="lazy" />
  <ol class="annot-screen-overlays" data-screen-overlays={id}>
    <slot />
  </ol>
</figure>
